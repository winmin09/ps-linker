  // Create Room Helper
  const handleCreateRoom = (e) => {
    e.preventDefault();
    if (!newRoomTitle.trim()) return;

    const { cleanText, isFiltered, foundWords } = filterText(newRoomTitle);
    if (isFiltered && profanityFilterMode === 'BLOCK') {
