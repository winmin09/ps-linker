  };

  // Handle Login Step 3: Set Anonymous Nickname & Complete Login
  const handleCompleteRegistration = (e) => {
    e.preventDefault();
    setAuthError('');

    const nick = authNickname.trim();
    if (!nick) {
      setAuthError('익명 닉네임을 입력해 주세요.');
