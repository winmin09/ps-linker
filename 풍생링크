    if (isFiltered) {
      setAuthError('닉네임에 비속어나 부적절한 단어가 포함되어 있습니다.');
      return;
    }

    // Complete Auth
    const newUser = {
      id: `u-${Date.now()}`,
      email: loginEmail.trim().toLowerCase(),
      nickname: nick,
      temperature: 36.5,
      role: '학생 (인증됨)',
      reportsCount: 0,
      profanityWarnings: 0,
      evaluatedUsers: {},
      bookings: [],
